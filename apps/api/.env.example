# ── Ambiente ────────────────────────────────────────────────────────────────
# development | test | production (em produção o Swagger fica desligado)
NODE_ENV=development
# Porta HTTP. A Railway define essa variável automaticamente.
PORT=3000

# ── Banco de dados (obrigatória) ────────────────────────────────────────────
# Local: o Postgres do docker-compose.yml. Na Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://loopscreen:loopscreen@localhost:5432/loopscreen?schema=public

# ── Autenticação (obrigatória) ──────────────────────────────────────────────
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-32+-caracteres
JWT_EXPIRES_IN=12h

# ── Admin criado pelo seed (ADMIN_PASSWORD é obrigatória) ───────────────────
ADMIN_EMAIL=admin@loopscreen.local
ADMIN_PASSWORD=troque-esta-senha

# ── Uploads ─────────────────────────────────────────────────────────────────
# Local: ./uploads | Railway: /data/uploads (Volume montado em /data)
UPLOAD_DIR=./uploads
# Tamanho máximo por arquivo, em MB
MAX_UPLOAD_MB=100

# ── Opcional ────────────────────────────────────────────────────────────────
# Diretório do build do front. Padrão: apps/web/dist
# WEB_DIST_DIR=
